<resources>
    <!-- Always-dark window so there is no white flash before Compose draws. -->
    <style name="Theme.Pace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pace_background</item>
        <item name="android:statusBarColor">@color/pace_background</item>
        <item name="android:navigationBarColor">@color/pace_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/pace_primary</item>
    </style>
</resources>
